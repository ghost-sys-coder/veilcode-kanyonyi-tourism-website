# Site
NEXT_PUBLIC_SITE_URL=https://kanyonyi.veilcode.studio      # http://localhost:3000 in development
NEXT_PUBLIC_DEMO_MODE=true                                  # demo bar and demo copy variants
SITE_INDEXING_ENABLED=                                     # exact true/false overrides demo default; previews always noindex
NEXT_PUBLIC_WHATSAPP_NUMBER=256750242627                    # digits only, for wa.me links

# Database (Neon)
DATABASE_URL=                                               # pooled connection string, used by the app
DATABASE_URL_UNPOOLED=                                      # direct connection, used for migrations only
IP_HASH_SECRET=                                            # 32 random bytes, encoded as 64 hex characters

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Kanyonyi Expeditions <enquiries@mail.veilcode.studio>"
ENQUIRY_NOTIFY_TO=frank@veilcode.studio                     # operator notification inbox
EMAIL_REPLY_TO=frank@veilcode.studio                        # reply-to on traveller confirmations

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=                              # G-XXXXXXXXXX
